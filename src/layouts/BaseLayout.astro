---
/*
 * BaseLayout — estrutura comum a todas as páginas: <head>, header, conteúdo, footer.
 */
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Analytics from "../components/Analytics.astro";
import { getSiteContent } from "../data/site";
import { getLang, languages, langs, alternatePath, defaultLang } from "../i18n";

interface Props {
  title?: string;
  description?: string;
}

// Idioma vem da URL ("/" = inglês, "/pt/" = português)
const lang = getLang(Astro.url);
const { site } = getSiteContent(lang);
const { title = site.title, description = site.description } = Astro.props;

// Endereços da mesma página nos dois idiomas (para o Google indicar a versão certa)
const alternates = langs.map((l) => ({
  hreflang: languages[l].htmlLang,
  href: new URL(alternatePath(Astro.url, l), Astro.site ?? Astro.url).href,
}));
const defaultHref = new URL(alternatePath(Astro.url, defaultLang), Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang={languages[lang].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={languages[lang].locale.replace("-", "_")} />

    <!-- Versões da página em cada idioma -->
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={defaultHref} />
    <!-- Favicon: monograma "DV" (arquivos em /public) -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Fontes (Google Fonts, gratuitas) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=Manrope:wght@500&family=Poltawski+Nowy:wght@400;500&display=swap"
    />

    <Analytics />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
