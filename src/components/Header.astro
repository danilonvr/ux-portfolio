---
/*
 * Header — fixo no topo, com espaçador para o conteúdo não ficar por baixo.
 *
 * Variantes (iguais ao Framer):
 *   desktop (≥1200): logo em pílula translúcida | nav em pílula | botão "Get in Touch"
 *   tablet  (810–1199): igual ao desktop, mas o logo sem pílula
 *   phone   (<810): logo + botão "Menu"; o menu abre expandindo o header para baixo
 *
 * Navegação (desktop/tablet): uma pílula única desliza até o item selecionado
 * (mesmo comportamento de liumichelle.com). Detalhes no script logo abaixo da <nav>.
 *
 * Spec: DESIGN-SYSTEM.md → Componentes → Header
 */
import Button from "./Button.astro";
import Placeholder from "./Placeholder.astro";
import { site, nav, links } from "../data/site";

// Item ativo no carregamento: Home na Home, About no About, Work nas páginas de case.
// Na Home, "Work" passa a ficar ativo quando a seção de projetos chega na tela (script abaixo).
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) => {
  if (href === "/#work") return path.startsWith("/project/");
  return href === path;
};
---

<div class="header-spacer" aria-hidden="true"></div>

<header class="site-header" data-open="false">
  <div class="inner container">
    <div class="bar">
      <a class="logo" href="/" aria-label={`${site.name} — Home`}>
        <!-- Avatar: placeholder até a foto entrar -->
        <span class="avatar"><Placeholder width={1} height={1} round /></span>
        <span class="logo-text">
          <span class="text-heading-xs logo-name">{site.name}</span>
          <span class="text-caption logo-location">{site.location}</span>
        </span>
      </a>

      <nav class="nav nav--bar" aria-label="Principal" data-nav>
        <span class="nav-pill" aria-hidden="true" data-nav-pill></span>
        {nav.map((item) => (
          <a
            class:list={["nav-item text-nav", { active: isActive(item.href) }]}
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
            data-nav-link
          >
            {item.label}
          </a>
        ))}
      </nav>
      <script is:inline>
        /*
         * Pílula da navegação — roda aqui, antes da página aparecer, para não "piscar".
         *
         * 1. Coloca a pílula sob o item ativo.
         * 2. Entre páginas: ao clicar num item, guarda onde a pílula estava. A página nova
         *    nasce com a pílula nesse ponto e desliza até o item certo.
         * 3. Na Home: "Work" acende quando a seção de projetos chega a ~25% da tela;
         *    clicar em Home/Work rola suavemente em vez de recarregar a página.
         */
        (function () {
          var nav = document.querySelector("[data-nav]");
          var pill = nav && nav.querySelector("[data-nav-pill]");
          if (!nav || !pill) return;
          var links = Array.prototype.slice.call(nav.querySelectorAll("[data-nav-link]"));
          var KEY = "nav-pill";
          var isHome = location.pathname === "/" || location.pathname === "";
          var reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
          var lockedUntil = 0;

          function linkFor(href) {
            return links.filter(function (a) { return a.getAttribute("href") === href; })[0];
          }

          function current() {
            return links.filter(function (a) { return a.classList.contains("active"); })[0];
          }

          function place(link, animate) {
            if (!link) return;
            pill.classList.toggle("is-animated", !!animate);
            pill.style.setProperty("--pill-x", link.offsetLeft + "px");
            pill.style.setProperty("--pill-w", link.offsetWidth + "px");
          }

          function setActive(link, animate) {
            if (!link || link === current()) return;
            links.forEach(function (a) {
              var on = a === link;
              a.classList.toggle("active", on);
              if (on) a.setAttribute("aria-current", "page");
              else a.removeAttribute("aria-current");
            });
            place(link, animate);
          }

          // Na Home, chegando por "/#work": Work já começa ativo
          if (isHome && location.hash === "#work") setActive(linkFor("/#work"), false);

          // Posição inicial: onde a pílula estava na página anterior (se acabou de navegar pela nav)
          var from = null;
          try {
            from = JSON.parse(sessionStorage.getItem(KEY) || "null");
            sessionStorage.removeItem(KEY);
          } catch (e) {}

          var target = current();
          if (from && Date.now() - from.t < 4000 && !reduceMotion) {
            pill.style.setProperty("--pill-x", from.x + "px");
            pill.style.setProperty("--pill-w", from.w + "px");
            nav.classList.add("has-pill");
            void pill.offsetWidth; // aplica a posição antiga antes de animar
            requestAnimationFrame(function () { place(target, true); });
          } else {
            place(target, false);
            nav.classList.add("has-pill");
          }

          // As fontes mudam a largura dos itens: reposiciona quando carregarem
          if (document.fonts) document.fonts.ready.then(function () { place(current(), true); });
          window.addEventListener("resize", function () { place(current(), false); });

          // Ao clicar num item: guarda a posição atual (para a próxima página animar a partir dela)
          links.forEach(function (link) {
            link.addEventListener("click", function (event) {
              var href = link.getAttribute("href");

              // Na Home, Home e Work só rolam a página
              if (isHome && (href === "/" || href === "/#work")) {
                event.preventDefault();
                setActive(link, true);
                lockedUntil = performance.now() + (reduceMotion ? 0 : 1200);
                var behavior = reduceMotion ? "auto" : "smooth";
                if (href === "/") {
                  window.scrollTo({ top: 0, behavior: behavior });
                  history.replaceState(null, "", "/");
                } else {
                  var section = document.getElementById("work");
                  if (section) section.scrollIntoView({ behavior: behavior, block: "start" });
                  history.replaceState(null, "", "/#work");
                }
                return;
              }

              try {
                sessionStorage.setItem(KEY, JSON.stringify({
                  x: pill.offsetLeft + (parseFloat(pill.style.getPropertyValue("--pill-x")) || 0),
                  w: parseFloat(pill.style.getPropertyValue("--pill-w")) || 0,
                  t: Date.now()
                }));
              } catch (e) {}
            });
          });

          // Na Home: Work acende quando a seção de projetos passa de ~25% da tela
          if (isHome) {
            var ticking = false;
            var headerHeight = function () {
              return parseFloat(getComputedStyle(document.documentElement).getPropertyValue("--header-height")) || 0;
            };
            var spy = function () {
              ticking = false;
              if (performance.now() < lockedUntil) return;
              var section = document.getElementById("work");
              if (!section) return;
              var reached = section.getBoundingClientRect().top <= headerHeight() + window.innerHeight * 0.25;
              var link = linkFor(reached ? "/#work" : "/");
              if (link !== current()) history.replaceState(null, "", reached ? "/#work" : "/");
              setActive(link, true);
            };
            window.addEventListener("scroll", function () {
              if (ticking) return;
              ticking = true;
              requestAnimationFrame(spy);
            }, { passive: true });
            window.addEventListener("scrollend", function () { lockedUntil = 0; spy(); });
            document.addEventListener("DOMContentLoaded", spy);
          }
        })();
      </script>

      <div class="action action--bar">
        <Button href={links.linkedin} external>Get in Touch</Button>
      </div>

      <button
        class="menu-toggle text-label"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="menu-toggle-label">Menu</span>
        <span class="menu-icon" aria-hidden="true">
          <span></span><span></span><span></span>
        </span>
      </button>
    </div>

    <!-- Painel do menu mobile: fechado por padrão (inert = fora do foco do teclado) -->
    <div class="mobile-panel" id="mobile-menu" inert>
      <div class="mobile-panel-clip">
        <div class="mobile-panel-content">
          <nav class="nav nav--panel" aria-label="Principal (mobile)">
            {nav.map((item) => (
              <a
                class:list={["nav-item text-nav", { active: isActive(item.href) }]}
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            ))}
          </nav>
          <Button href={links.linkedin} external>Get in Touch</Button>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  /* ---------- Estrutura ---------- */
  .header-spacer {
    height: var(--header-height);
  }

  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 10;
    padding: var(--header-pad-y) var(--page-gutter);
    background: var(--color-bg);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 44px;
  }

  /* ---------- Logo ---------- */
  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    /* Desktop: pílula translúcida */
    padding: var(--space-4) var(--space-12) var(--space-4) var(--space-4);
    border-radius: var(--radius-pill);
    background: var(--color-glass);
    backdrop-filter: var(--blur-glass);
    -webkit-backdrop-filter: var(--blur-glass);
  }

  .avatar {
    display: block;
    width: var(--avatar-size);
    height: var(--avatar-size);
    flex-shrink: 0;
  }

  .logo-text {
    display: flex;
    flex-direction: column;
  }

  .logo-name {
    color: var(--color-text-primary);
  }

  .logo-location {
    color: var(--color-text-muted);
  }

  /* ---------- Nav ---------- */
  .nav {
    display: flex;
    align-items: center;
    gap: var(--space-10);
  }

  .nav--bar {
    position: relative;
    padding: var(--space-4);
    border-radius: var(--radius-round);
    background: var(--color-glass);
    backdrop-filter: var(--blur-glass);
    -webkit-backdrop-filter: var(--blur-glass);
  }

  .nav-item {
    position: relative; /* fica acima da pílula */
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-10) var(--space-16);
    border-radius: var(--radius-pill);
    color: var(--color-text-tertiary);
    transition: color var(--duration-fast) var(--ease-decelerate);
  }

  /* Hover só escurece o texto; a pílula não se move (igual à referência) */
  .nav-item:hover,
  .nav-item.active {
    color: var(--color-text-primary);
  }

  /* Pílula do item selecionado: fundo claro + contorno de 1px para dar elevação.
     Uma só para a nav inteira; o script a posiciona e ela desliza entre os itens. */
  .nav-pill {
    position: absolute;
    top: var(--space-4);
    bottom: var(--space-4);
    left: 0;
    width: var(--pill-w, 0px);
    transform: translateX(var(--pill-x, 0px));
    border-radius: var(--radius-pill);
    background: var(--color-selected-bg);
    box-shadow: inset 0 0 0 1px var(--color-selected-border);
    opacity: 0;
    pointer-events: none;
  }

  .nav--bar.has-pill .nav-pill {
    opacity: 1;
  }

  .nav-pill.is-animated {
    transition:
      transform var(--duration-base) var(--ease-decelerate),
      width var(--duration-base) var(--ease-decelerate);
  }

  /* Sem JavaScript (ou no menu mobile): o próprio item recebe o fundo */
  .nav--bar:not(.has-pill) .nav-item.active,
  .nav--panel .nav-item.active {
    background: var(--color-selected-bg);
    box-shadow: inset 0 0 0 1px var(--color-selected-border);
  }

  /* ---------- Toggle do menu (só phone) ---------- */
  .menu-toggle {
    display: none;
    align-items: center;
    gap: var(--space-5);
    color: var(--color-text-primary);
  }

  .menu-icon {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 12px;
    height: 10px;
  }

  .menu-icon span {
    display: block;
    width: 100%;
    height: 1px;
    background: var(--color-text-muted);
    transition:
      transform var(--duration-base) var(--ease-standard),
      opacity var(--duration-fast) var(--ease-standard);
  }

  /* Aberto: linhas de cima e de baixo viram um X, a do meio some */
  .site-header[data-open="true"] .menu-icon span:nth-child(1) {
    transform: translateY(4.5px) rotate(45deg);
  }
  .site-header[data-open="true"] .menu-icon span:nth-child(2) {
    opacity: 0;
  }
  .site-header[data-open="true"] .menu-icon span:nth-child(3) {
    transform: translateY(-4.5px) rotate(-45deg);
  }

  /* ---------- Painel mobile ---------- */
  .mobile-panel {
    display: none;
  }

  /* ---------- Tablet ---------- */
  @media (max-width: 1199.98px) {
    .logo {
      padding: 0;
      background: none;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }

  /* ---------- Phone ---------- */
  @media (max-width: 809.98px) {
    .bar {
      min-height: 34px;
    }

    .nav--bar,
    .action--bar {
      display: none;
    }

    .menu-toggle {
      display: inline-flex;
    }

    /* Altura animada com a técnica de grid 0fr → 1fr */
    .mobile-panel {
      display: grid;
      grid-template-rows: 0fr;
      transition: grid-template-rows var(--duration-base) var(--ease-standard);
    }

    .site-header[data-open="true"] .mobile-panel {
      grid-template-rows: 1fr;
    }

    .mobile-panel-clip {
      overflow: hidden;
      min-height: 0;
    }

    .mobile-panel-content {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-50);
      /* 50px abaixo da barra; 30px + 20px do header = 50px no fim */
      padding: var(--space-50) 0 var(--space-30);
    }

    .nav--panel {
      flex-direction: column;
      gap: var(--space-20);
    }
  }
</style>

<script>
  // Abre/fecha o menu mobile. Fecha com Esc e ao voltar para tablet/desktop.
  const header = document.querySelector<HTMLElement>(".site-header");
  const toggle = header?.querySelector<HTMLButtonElement>(".menu-toggle");
  const label = header?.querySelector<HTMLElement>(".menu-toggle-label");
  const panel = header?.querySelector<HTMLElement>(".mobile-panel");

  function setOpen(open: boolean) {
    if (!header || !toggle || !label || !panel) return;
    header.dataset.open = String(open);
    toggle.setAttribute("aria-expanded", String(open));
    label.textContent = open ? "Close" : "Menu";
    panel.inert = !open;
  }

  toggle?.addEventListener("click", () => {
    setOpen(header?.dataset.open !== "true");
  });

  // Escolher um item do menu fecha o menu (ex.: "Work" rola a Home até os projetos)
  header?.querySelectorAll(".nav--panel a").forEach((link) => {
    link.addEventListener("click", () => setOpen(false));
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && header?.dataset.open === "true") {
      setOpen(false);
      toggle?.focus();
    }
  });

  window.matchMedia("(min-width: 810px)").addEventListener("change", (event) => {
    if (event.matches) setOpen(false);
  });
</script>
