---
/*
 * PageStub — TEMPORÁRIO. Marca páginas que ainda não foram construídas.
 * Remover quando a página real entrar (ordem: Home → About → template de case).
 */
import { getLang } from "../i18n";
import { useTranslations } from "../i18n/ui";

interface Props {
  name: string;
}
const { name } = Astro.props;
const t = useTranslations(getLang(Astro.url));
---

<section class="stub">
  <div class="container">
    <p class="text-caption">{t("stub.label")} {name}</p>
  </div>
</section>

<style>
  .stub {
    padding: var(--space-100) var(--page-gutter);
    min-height: 50vh;
    color: var(--color-text-muted);
  }
</style>
