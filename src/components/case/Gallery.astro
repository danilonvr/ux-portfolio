---
import Icon from "../Icon.astro";
import { getLang } from "../../i18n";
import { useTranslations } from "../../i18n/ui";
/*
 * Gallery — carrossel de fotos com setas (ex.: fotos de pesquisa).
 * Mostra 2 por vez no desktop/tablet e 1 no phone; as setas avançam uma foto.
 * Também rola com o dedo/trackpad (scroll-snap).
 * Uso: <Gallery labels={["Reunião 1", "Reunião 2", …]} ratio="4/3" />
 */
interface Props {
  labels: string[];
  ratio?: string;
  caption?: string;
}

const { labels, ratio = "4/3", caption } = Astro.props;
const t = useTranslations(getLang(Astro.url));
---

<figure class="gallery" data-gallery>
  <div class="viewport" data-gallery-viewport tabindex="0" aria-label={t("gallery.label")}>
    {labels.map((label, i) => (
      <div class="slide" style={`aspect-ratio: ${ratio.replace("/", " / ")}`} role="img" aria-label={label}>
        <span class="text-small placeholder-label">[{t("media.image")} {i + 1} · {label}]</span>
      </div>
    ))}
  </div>
  <div class="controls">
    <span class="text-small counter" data-gallery-counter aria-live="polite">1 / {labels.length}</span>
    <div class="buttons">
      <button type="button" class="arrow" aria-label={t("gallery.prev")} data-gallery-prev>
        <Icon name="arrow-left" size={18} />
      </button>
      <button type="button" class="arrow" aria-label={t("gallery.next")} data-gallery-next>
        <Icon name="arrow-right" size={18} />
      </button>
    </div>
  </div>
  {caption && <figcaption class="text-small caption">{caption}</figcaption>}
</figure>

<style>
  .gallery {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
    margin: var(--space-24) 0;
  }

  .viewport {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - var(--space-20)) / 2);
    gap: var(--space-20);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
  }

  .viewport::-webkit-scrollbar {
    display: none;
  }

  .slide {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-16);
    border-radius: var(--radius-lg);
    background: var(--color-border);
    scroll-snap-align: start;
  }

  .placeholder-label,
  .counter,
  .caption {
    color: var(--color-text-tertiary);
  }

  .controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .buttons {
    display: flex;
    gap: var(--space-10);
  }

  .arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-text-primary);
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .arrow:hover {
    color: var(--color-highlight);
  }

  .arrow:disabled {
    color: var(--color-border);
    cursor: default;
  }

  @media (max-width: 809.98px) {
    .viewport {
      grid-auto-columns: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .viewport {
      scroll-behavior: auto;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-gallery]").forEach((gallery) => {
    const viewport = gallery.querySelector<HTMLElement>("[data-gallery-viewport]");
    const prev = gallery.querySelector<HTMLButtonElement>("[data-gallery-prev]");
    const next = gallery.querySelector<HTMLButtonElement>("[data-gallery-next]");
    const counter = gallery.querySelector<HTMLElement>("[data-gallery-counter]");
    if (!viewport || !prev || !next) return;

    const slides = Array.from(viewport.children) as HTMLElement[];
    const step = () => (slides[1] ? slides[1].offsetLeft - slides[0].offsetLeft : viewport.clientWidth);

    function update() {
      const index = Math.round(viewport!.scrollLeft / step());
      const maxScroll = viewport!.scrollWidth - viewport!.clientWidth;
      prev!.disabled = viewport!.scrollLeft <= 2;
      next!.disabled = viewport!.scrollLeft >= maxScroll - 2;
      if (counter) counter.textContent = `${Math.min(index + 1, slides.length)} / ${slides.length}`;
    }

    prev.addEventListener("click", () => viewport.scrollBy({ left: -step() }));
    next.addEventListener("click", () => viewport.scrollBy({ left: step() }));
    viewport.addEventListener("keydown", (event) => {
      if (event.key === "ArrowRight") viewport.scrollBy({ left: step() });
      if (event.key === "ArrowLeft") viewport.scrollBy({ left: -step() });
    });
    viewport.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
    update();
  });
</script>
