---
/*
 * CaseToc — sumário do case ("On this page") com scroll-spy.
 *
 * desktop (≥1200px): coluna à esquerda, fixa enquanto a página rola.
 *   - Lista as seções (##). A seção atual se abre e mostra suas subseções (###), com recuo;
 *     as outras ficam fechadas. Só um grupo aberto por vez. Quem abre e fecha é a ROLAGEM
 *     (clicar numa seção rola até ela, e ela abre como consequência).
 *   - Seção e subseção atuais em --color-highlight (verde); o resto esmaecido (--color-text-tertiary).
 *   - Uma barra de 2px desliza até o item mais específico ativo (subseção, se houver).
 * tablet e phone (<1200px): barra compacta fixa abaixo do header, só com as seções (##).
 *
 * A lista é montada a partir dos títulos "##" e "###" do arquivo .mdx do case.
 * Spec: DESIGN-SYSTEM.md → Componentes → CaseToc
 */
interface Props {
  items: { slug: string; text: string; children: { slug: string; text: string }[] }[];
  label?: string;
}

const { items, label = "On this page" } = Astro.props;

// Índice único para cada título, na ordem em que aparecem na página
let counter = 0;
const tree = items.map((item) => {
  const index = counter++;
  return {
    ...item,
    index,
    children: item.children.map((child) => ({ ...child, index: counter++, parent: index })),
  };
});
---

<!-- Desktop: coluna lateral -->
<nav class="toc" aria-label={label} data-toc>
  <p class="text-small toc-label">{label}</p>
  <div class="toc-track" data-toc-track>
    <span class="toc-indicator" aria-hidden="true" data-toc-indicator></span>
    <ol class="toc-list">
      {tree.map((item) => (
        <li class="toc-item" data-toc-group={item.index}>
          <a
            class="toc-link text-small"
            href={`#${item.slug}`}
            data-toc-link
            data-index={item.index}
            data-parent={item.index}
          >
            {item.text}
          </a>
          {item.children.length > 0 && (
            <div class="toc-sub" data-toc-sub inert>
              <ol class="toc-sub-list">
                {item.children.map((child) => (
                  <li>
                    <a
                      class="toc-link toc-link--sub text-small"
                      href={`#${child.slug}`}
                      data-toc-link
                      data-index={child.index}
                      data-parent={child.parent}
                    >
                      {child.text}
                    </a>
                  </li>
                ))}
              </ol>
            </div>
          )}
        </li>
      ))}
    </ol>
  </div>
</nav>

<!-- Tablet e phone: barra compacta (só seções) -->
<nav class="toc-bar" aria-label={`${label} (compacto)`} data-toc-bar>
  <button class="toc-bar-button" type="button" aria-expanded="false" aria-controls="toc-bar-panel">
    <span class="text-small toc-bar-label">{label}</span>
    <span class="text-body toc-bar-current" data-toc-current>{items[0]?.text}</span>
    <svg class="toc-bar-chevron" viewBox="0 0 256 256" width="16" height="16" aria-hidden="true" fill="currentColor">
      <path d="M213.66,101.66l-80,80a8,8,0,0,1-11.32,0l-80-80A8,8,0,0,1,53.66,90.34L128,164.69l74.34-74.35a8,8,0,0,1,11.32,11.32Z" />
    </svg>
  </button>
  <div class="toc-bar-panel" id="toc-bar-panel" hidden>
    <ol class="toc-bar-list">
      {tree.map((item) => (
        <li>
          <a
            class="toc-link text-body"
            href={`#${item.slug}`}
            data-toc-link
            data-index={item.index}
            data-parent={item.index}
          >
            {item.text}
          </a>
        </li>
      ))}
    </ol>
  </div>
</nav>

<style>
  /* ---------- Desktop: coluna lateral fixa ---------- */
  .toc {
    position: sticky;
    top: calc(var(--header-height) + var(--space-24));
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
    width: 240px;
    flex-shrink: 0;
  }

  .toc-label {
    color: var(--color-text-tertiary);
  }

  .toc-track {
    position: relative;
    border-left: 1px solid var(--color-border);
  }

  /* Barra que desliza até o item ativo */
  .toc-indicator {
    position: absolute;
    left: -1px;
    top: 0;
    width: 2px;
    height: var(--indicator-height, 0px);
    background: var(--color-highlight);
    transform: translateY(var(--indicator-y, 0px));
    transition:
      transform var(--duration-base) var(--ease-out),
      height var(--duration-base) var(--ease-out);
  }

  .toc-list {
    display: flex;
    flex-direction: column;
  }

  .toc-link {
    display: block;
    padding: var(--space-8) 0 var(--space-8) var(--space-16);
    color: var(--color-text-tertiary);
    transition: color var(--duration-base) var(--ease-standard);
  }

  /* Hover escurece o texto (não usa o verde, que aqui significa "ativo") */
  .toc-link:hover {
    color: var(--color-text-primary);
  }

  .toc-link.is-active {
    color: var(--color-highlight);
  }

  /* Subseções: recuo de 12px a mais que as seções */
  .toc-link--sub {
    padding-left: calc(var(--space-16) + var(--space-12));
  }

  /* Grupo de subseções: abre e fecha animando a altura (técnica grid 0fr → 1fr) */
  .toc-sub {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows var(--duration-base) var(--ease-out),
      opacity var(--duration-base) var(--ease-standard);
  }

  .toc-sub > .toc-sub-list {
    min-height: 0;
    overflow: hidden;
  }

  .toc-item.is-open .toc-sub {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  /* ---------- Tablet e phone: barra compacta ---------- */
  .toc-bar {
    display: none;
  }

  @media (max-width: 1199.98px) {
    .toc {
      display: none;
    }

    .toc-bar {
      display: block;
      position: sticky;
      top: var(--header-height);
      z-index: 5;
      /* Ocupa a largura toda da tela, além do padding da página */
      margin-inline: calc(var(--page-gutter) * -1);
      padding-inline: var(--page-gutter);
      background: var(--color-bg);
      border-top: 1px solid var(--color-border);
      border-bottom: 1px solid var(--color-border);
    }

    .toc-bar-button {
      display: flex;
      align-items: center;
      gap: var(--space-10);
      width: 100%;
      min-height: 48px;
      text-align: left;
    }

    .toc-bar-label {
      color: var(--color-text-tertiary);
      flex-shrink: 0;
    }

    .toc-bar-current {
      flex: 1;
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      color: var(--color-text-primary);
    }

    .toc-bar-chevron {
      flex-shrink: 0;
      color: var(--color-text-tertiary);
      transition: transform var(--duration-base) var(--ease-standard);
    }

    .toc-bar-button[aria-expanded="true"] .toc-bar-chevron {
      transform: rotate(180deg);
    }

    .toc-bar-panel {
      padding-bottom: var(--space-12);
      max-height: 60vh;
      overflow-y: auto;
    }

    .toc-bar-list .toc-link {
      padding: var(--space-10) 0 var(--space-10) var(--space-12);
      border-left: 2px solid transparent;
    }

    .toc-bar-list .toc-link.is-active {
      border-left-color: var(--color-highlight);
    }
  }
</style>

<script>
  const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]"));
  const sidebarLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-toc] [data-toc-link]"));
  const groups = Array.from(document.querySelectorAll<HTMLElement>("[data-toc-group]"));
  const indicator = document.querySelector<HTMLElement>("[data-toc-indicator]");
  const currentLabel = document.querySelector<HTMLElement>("[data-toc-current]");
  const bar = document.querySelector<HTMLElement>("[data-toc-bar]");
  const barButton = bar?.querySelector<HTMLButtonElement>(".toc-bar-button");
  const barPanel = bar?.querySelector<HTMLElement>(".toc-bar-panel");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  // Um item por título (## e ###), na ordem da página. O índice bate com data-index.
  const entries = sidebarLinks
    .map((link) => ({
      link,
      index: Number(link.dataset.index),
      parent: Number(link.dataset.parent),
      isSection: link.dataset.index === link.dataset.parent,
      heading: document.getElementById(decodeURIComponent(link.hash.slice(1))),
    }))
    .filter((entry) => entry.heading !== null)
    .sort((a, b) => a.index - b.index);

  const byIndex = new Map(entries.map((entry) => [entry.index, entry]));
  const sections = entries.filter((entry) => entry.isSection);

  let activeKey = "";
  let activeIndexes: number[] = [];
  let lockedUntil = 0; // durante a rolagem causada por um clique, o destaque não muda

  const headerHeight = () =>
    parseFloat(getComputedStyle(document.documentElement).getPropertyValue("--header-height")) || 0;
  const topOf = (el: HTMLElement | null) => el?.getBoundingClientRect().top ?? 0;

  // Seções na mesma altura da página (lado a lado, ex.: Context | Solution) formam um grupo
  function sectionGroup(sectionIndex: number): number[] {
    const top = topOf(byIndex.get(sectionIndex)?.heading ?? null);
    return sections.filter((s) => Math.abs(topOf(s.heading) - top) < 4).map((s) => s.index);
  }

  // Item atual = o último título (seção ou subseção) que já passou de ~25% da área visível
  function findActive(): number {
    const line = headerHeight() + window.innerHeight * 0.25;
    let current = entries[0]?.index ?? 0;
    for (const entry of entries) {
      if (topOf(entry.heading) <= line) current = entry.index;
    }
    // Fim da página: a última seção fica ativa mesmo que o título não tenha subido o bastante
    const atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4;
    if (atBottom) current = sections[sections.length - 1]?.index ?? current;
    return current;
  }

  // Ativa o item e tudo que depende dele: a seção-mãe (e vizinhas lado a lado) e o grupo aberto
  function setActive(index: number) {
    const entry = byIndex.get(index);
    if (!entry) return;
    const sectionIndexes = sectionGroup(entry.parent);
    const indexes = entry.isSection ? sectionIndexes : [...sectionIndexes, index];
    const key = indexes.join();
    if (key === activeKey) return;
    activeKey = key;
    activeIndexes = indexes;

    tocLinks.forEach((link) => {
      const isActive = indexes.includes(Number(link.dataset.index));
      link.classList.toggle("is-active", isActive);
      if (isActive) link.setAttribute("aria-current", "location");
      else link.removeAttribute("aria-current");
    });

    // Abre só o grupo da seção atual; os outros fecham
    groups.forEach((group) => {
      const isOpen = sectionIndexes.includes(Number(group.dataset.tocGroup));
      group.classList.toggle("is-open", isOpen);
      const sub = group.querySelector<HTMLElement>("[data-toc-sub]");
      if (sub) sub.inert = !isOpen;
    });

    followIndicator();
    if (currentLabel) {
      currentLabel.textContent = sectionIndexes.map((i) => byIndex.get(i)?.heading?.textContent ?? "").join(" · ");
    }
  }

  // A barra cobre o item mais específico ativo: a subseção, se houver; senão a(s) seção(ões)
  function moveIndicator() {
    const sub = activeIndexes.find((i) => !byIndex.get(i)?.isSection);
    const targets = sub !== undefined ? [sub] : activeIndexes;
    const first = byIndex.get(targets[0])?.link;
    const last = byIndex.get(targets[targets.length - 1])?.link;
    if (!indicator || !first || !last) return;
    indicator.style.setProperty("--indicator-y", `${first.offsetTop}px`);
    indicator.style.setProperty("--indicator-height", `${last.offsetTop + last.offsetHeight - first.offsetTop}px`);
  }

  // Enquanto um grupo abre/fecha, os itens se movem: a barra acompanha quadro a quadro
  function followIndicator() {
    const until = performance.now() + (reduceMotion.matches ? 0 : 350);
    const step = () => {
      moveIndicator();
      if (performance.now() < until) requestAnimationFrame(step);
    };
    step();
  }

  // Atualiza no máximo uma vez por quadro durante a rolagem
  let ticking = false;
  function onScroll() {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      ticking = false;
      if (performance.now() < lockedUntil) return;
      setActive(findActive());
    });
  }

  // ---------- Barra compacta (tablet/phone) ----------
  function setPanel(open: boolean) {
    if (!barButton || !barPanel) return;
    barButton.setAttribute("aria-expanded", String(open));
    barPanel.hidden = !open;
  }

  barButton?.addEventListener("click", () => {
    setPanel(barButton.getAttribute("aria-expanded") !== "true");
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && barButton?.getAttribute("aria-expanded") === "true") {
      setPanel(false);
      barButton.focus();
    }
  });

  document.addEventListener("click", (event) => {
    if (bar && !bar.contains(event.target as Node)) setPanel(false);
  });

  // ---------- Clique num item: rolagem suave até o título ----------
  tocLinks.forEach((link) => {
    link.addEventListener("click", (event) => {
      const entry = byIndex.get(Number(link.dataset.index));
      const target = entry?.heading;
      if (!entry || !target) return;
      event.preventDefault();

      setPanel(false);
      setActive(entry.index);
      // Trava o destaque no item clicado até a rolagem terminar
      lockedUntil = performance.now() + (reduceMotion.matches ? 0 : 1000);

      target.scrollIntoView({ behavior: reduceMotion.matches ? "auto" : "smooth", block: "start" });
      history.replaceState(null, "", `#${target.id}`);

      // Leva o foco do teclado para o título, sem rolar de novo
      target.setAttribute("tabindex", "-1");
      target.focus({ preventScroll: true });
    });
  });

  // Fim da rolagem: libera a trava e confere a posição
  window.addEventListener("scrollend", () => {
    lockedUntil = 0;
    setActive(findActive());
  });

  window.addEventListener("scroll", onScroll, { passive: true });
  window.addEventListener("resize", () => {
    moveIndicator();
    onScroll();
  });

  // As fontes mudam a altura dos itens: reposiciona a barra quando carregarem
  document.fonts?.ready.then(moveIndicator);
  setActive(findActive());
</script>
