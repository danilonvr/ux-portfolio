---
/*
 * GridItem — item de <Grid>: título serifado + texto curto.
 */
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="grid-item">
  <h3 class="text-heading-item item-title">{title}</h3>
  <div class="text-small item-text"><slot /></div>
</div>

<style>
  .grid-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    padding: var(--space-20);
    border-bottom: 1px solid var(--color-border);
  }

  .item-title {
    color: var(--color-text-primary);
  }

  .item-text {
    color: var(--color-text-secondary);
  }

  .item-text :global(p) {
    margin: 0;
  }
</style>
