---
/*
 * ProjectsSection — título "Projects" + grade de cards.
 * desktop/tablet: 2 colunas · phone: 1 coluna · gap 20px.
 *
 * O id="projects" fica no título (igual ao Framer), porque é para onde o link "Work" leva.
 */
import ProjectCard from "../ProjectCard.astro";
import { projects, projectsSection } from "../../data/home";
---

<section class="projects">
  <div class="inner container">
    <h2 id="projects" class="text-heading-lg title">{projectsSection.title}</h2>
    <div class="grid">
      {projects.map((project) => (
        <ProjectCard
          href={`/project/${project.slug}`}
          title={project.title}
          description={project.description}
          category={project.category}
          year={project.year}
        />
      ))}
    </div>
  </div>
</section>

<style>
  .projects {
    padding: var(--section-pad-y) var(--page-gutter);
  }

  .inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-50);
  }

  .title {
    color: var(--color-text);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: var(--space-20);
  }

  @media (max-width: 809.98px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
