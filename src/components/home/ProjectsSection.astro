---
/*
 * ProjectsSection — título "Work" + grade de cards.
 * desktop/tablet: 2 colunas · phone: 1 coluna · gap 20px.
 *
 * O id="work" fica no título: é para onde o item "Work" da navegação leva.
 */
import ProjectCard from "../ProjectCard.astro";
import { projects, projectsSection } from "../../data/home";
---

<section class="projects">
  <div class="inner container">
    <h2 id="work" class="text-heading-lg title">{projectsSection.title}</h2>
    <div class="grid">
      {projects.map((project) => (
        <ProjectCard
          href={`/project/${project.slug}`}
          title={project.title}
          description={project.description}
          category={project.category}
          year={project.year}
        />
      ))}
    </div>
  </div>
</section>

<style>
  .projects {
    padding: var(--section-pad-y) var(--page-gutter);
  }

  .inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-50);
  }

  .title {
    color: var(--color-text-primary);
    /* Ao chegar pelo link "Work", o título para logo abaixo do header fixo (antes ficava escondido) */
    scroll-margin-top: calc(var(--header-height) + var(--space-24));
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: var(--space-20);
  }

  @media (max-width: 809.98px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
