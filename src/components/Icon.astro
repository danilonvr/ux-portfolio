---
/*
 * Icon — ícones do Phosphor (estilo "regular"), os mesmos usados no Framer.
 * Herdam a cor do texto (currentColor). Tamanho via prop `size` (px).
 * Para adicionar um ícone: copie o path em https://phosphoricons.com (regular, viewBox 256).
 */
interface Props {
  name: "arrow-up-right" | "linkedin" | "x" | "buildings" | "calendar";
  size?: number;
  label?: string; // preencha só quando o ícone for o único conteúdo de um link/botão
}

const { name, size = 14, label } = Astro.props;

