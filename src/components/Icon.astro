---
/*
 * Icon — ícones do Phosphor (https://phosphoricons.com), lidos direto do pacote oficial
 * @phosphor-icons/core. Regra do projeto: TODOS os ícones do site vêm daqui.
 *
 * Uso: <Icon name="globe" />  ·  <Icon name="buildings" weight="light" size={16} />
 *   name   = nome do ícone no site do Phosphor (ex.: "arrow-up-right", "linkedin-logo")
 *   weight = estilo: thin | light | regular (padrão) | bold | fill | duotone
 *   size   = tamanho em px (padrão 14)
 *   label  = preencha só quando o ícone for o único conteúdo de um link/botão
 *
 * O ícone herda a cor do texto (currentColor). Nome errado = erro no build, de propósito.
 *
 * EN: Phosphor icons read from the official package. Every icon on the site comes from here.
 */
interface Props {
  name: string;
  weight?: "thin" | "light" | "regular" | "bold" | "fill" | "duotone";
  size?: number;
  label?: string;
  class?: string;
}

const { name, weight = "regular", size = 14, label, class: className } = Astro.props;

// Todos os SVGs do pacote, carregados sob demanda (só o ícone usado entra no build)
const icons = import.meta.glob<string>("/node_modules/@phosphor-icons/core/assets/*/*.svg", {
  query: "?raw",
  import: "default",
});

const file = weight === "regular" ? `${name}.svg` : `${name}-${weight}.svg`;
const key = `/node_modules/@phosphor-icons/core/assets/${weight}/${file}`;
const load = icons[key];
if (!load) throw new Error(`Ícone Phosphor não encontrado: "${name}" (${weight})`);

// Mantém só o conteúdo de dentro do <svg> do pacote; o <svg> externo é montado aqui
const raw = await load();
const inner = raw.replace(/^[\s\S]*?<svg[^>]*>/, "").replace(/<\/svg>\s*$/, "");
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 256 256"
  width={size}
  height={size}
  fill="currentColor"
  class={className}
  aria-hidden={label ? undefined : "true"}
  aria-label={label}
  role={label ? "img" : undefined}
  focusable="false"
  set:html={inner}
/>
